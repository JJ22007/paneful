+/// "Tile all" with a focused window: it takes the left half, the other n-1 windows stack in the right half.
+/// The first rect is for the focused window. One window alone fills the screen.
+func focusLeftLayout(count n: Int, visible v: CGRect, gap: CGFloat = 0) -> [CGRect] {
+    guard n > 0 else { return [] }
+    if n == 1 { return [screenRect(unit: CGRect(x: 0, y: 0, width: 1, height: 1), visible: v, gap: gap)] }
+    var out = [screenRect(unit: CGRect(x: 0, y: 0, width: 0.5, height: 1), visible: v, gap: gap)]
+    let h = 1.0 / CGFloat(n - 1)
+    for i in 0..<(n - 1) {
+        out.append(screenRect(unit: CGRect(x: 0.5, y: CGFloat(i) * h, width: 0.5, height: h), visible: v, gap: gap))
+    }
+    return out
+}
+
